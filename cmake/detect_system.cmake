# Which system a ROM file is for, from its bytes: the rules of core/detect.h
# and systems/*/runtime/detect.c, here for the build's ROMS list, so the
# build and retrocast agree (tests/test_detect.py runs both on the same
# files). detect_system(FILE VAR) sets VAR to nes, gb, genesis, atari2600,
# mastersystem, gamegear or cps1, or stops with a message.
#   cmake -DFILE=game.bin -P cmake/detect_system.cmake   prints it
# The CPS-1 game table (systems/cps1/runtime/games.c, or GAMES_C): each
# game's "CRC:size" list in cps1_files_<id>, its ids in cps1_games. A game
# opens with `    {"id", "title", ...n, {` and has n lines of
# `        {0xCRC, N * K, ...`; a table read otherwise stops the build.
function(cps1_table)
    if(DEFINED GAMES_C)
        set(path "${GAMES_C}")
    else()
        set(path "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../systems/cps1/runtime/games.c")
    endif()
    file(STRINGS "${path}" lines)
    set(games "")
    set(id "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^    {\"([a-z0-9]+)\", \".*, ([0-9]+), {$")
            if(id AND NOT got EQUAL want)
                message(FATAL_ERROR "${path}: ${id} lists ${want} files, ${got} read (keep games.c's layout)")
            endif()
            set(id ${CMAKE_MATCH_1})
            set(want ${CMAKE_MATCH_2})
            if(want EQUAL 0)  # no files would match every zip
                message(FATAL_ERROR "${path}: ${id} lists no files")
            endif()
            set(got 0)
            set(files_${id} "")
            list(APPEND games ${id})
        elseif(line MATCHES "^        {0x([0-9a-f]+), ([0-9]+) \\* K, CPS1_R_")
            if(NOT id)
                message(FATAL_ERROR "${path}: a file line before any game it belongs to (keep games.c's layout)")
            endif()
            math(EXPR bytes "${CMAKE_MATCH_2} * 1024")
            set(crc ${CMAKE_MATCH_1})
            string(LENGTH "${crc}" cl)
            while(cl LESS 8)  # as the zip's CRCs are written
                set(crc "0${crc}")
                math(EXPR cl "${cl} + 1")
            endwhile()
            if(NOT line MATCHES ", 1},")  # a clone's file from its parent's zip: not needed to know it
                list(APPEND files_${id} "${crc}:${bytes}")
            endif()
            math(EXPR got "${got} + 1")
        endif()
    endforeach()
    if(NOT games OR (id AND NOT got EQUAL want))
        message(FATAL_ERROR "${path}: ${id} lists ${want} files, ${got} read (keep games.c's layout)")
    endif()
    set(cps1_games ${games} PARENT_SCOPE)
    foreach(g IN LISTS games)
        set(cps1_files_${g} ${files_${g}} PARENT_SCOPE)
    endforeach()
endfunction()

# hex bytes (two digits each) at a byte offset, little-endian, as a number
function(zip_le hex at n out)
    set(v 0)
    math(EXPR i "${n} - 1")
    foreach(k RANGE ${i} 0 -1)
        math(EXPR pos "(${at} + ${k}) * 2")
        string(SUBSTRING "${hex}" ${pos} 2 b)
        math(EXPR v "${v} * 256 + 0x${b}")
    endforeach()
    set(${out} ${v} PARENT_SCOPE)
endfunction()

# the entries of a zip's central directory as "crc:size" (crc in 8 hex digits)
function(zip_entries file size out)
    set(${out} "" PARENT_SCOPE)
    set(tail 65557)
    if(size LESS tail)
        set(tail ${size})
    endif()
    math(EXPR start "${size} - ${tail}")
    file(READ "${file}" hex OFFSET ${start} LIMIT ${tail} HEX)
    string(FIND "${hex}" "504b0506" at REVERSE)
    if(at LESS 0 OR NOT at MATCHES "[02468]$")
        return()
    endif()
    math(EXPR eocd "${at} / 2")
    zip_le("${hex}" ${eocd}+10 2 count)
    zip_le("${hex}" ${eocd}+12 4 dirsize)
    zip_le("${hex}" ${eocd}+16 4 dir)
    math(EXPR end "${dir} + ${dirsize}")
    if(count EQUAL 0 OR end GREATER size)
        return()
    endif()
    file(READ "${file}" d OFFSET ${dir} LIMIT ${dirsize} HEX)
    set(list "")
    set(p 0)
    foreach(i RANGE 1 ${count})
        math(EXPR need "(${p} + 46) * 2")
        string(LENGTH "${d}" len)
        if(need GREATER len)
            return()
        endif()
        math(EXPR s "${p} * 2")
        string(SUBSTRING "${d}" ${s} 8 sig)
        if(NOT sig STREQUAL "504b0102")
            return()
        endif()
        zip_le("${d}" ${p}+16 4 crc)
        zip_le("${d}" ${p}+24 4 usize)
        zip_le("${d}" ${p}+28 2 nlen)
        zip_le("${d}" ${p}+30 2 elen)
        zip_le("${d}" ${p}+32 2 clen)
        math(EXPR crc "${crc}" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${crc}" 2 -1 crc)
        string(LENGTH "${crc}" cl)
        while(cl LESS 8)
            set(crc "0${crc}")
            math(EXPR cl "${cl} + 1")
        endwhile()
        list(APPEND list "${crc}:${usize}")
        math(EXPR p "${p} + 46 + ${nlen} + ${elen} + ${clen}")
    endforeach()
    set(${out} ${list} PARENT_SCOPE)
endfunction()

function(detect_system file out)
    file(SIZE "${file}" size)
    file(READ "${file}" head LIMIT 512 HEX)  # two hex digits a byte
    get_filename_component(ext "${file}" LAST_EXT)
    string(TOLOWER "${ext}" ext)
    set(nes 0)
    set(gb 0)
    set(md 0)
    set(a26 0)
    set(sms 0)
    set(gg 0)
    set(cps1 0)
    cps1_table()  # read every time: a table the rule cannot read stops the build
    # CPS-1: a zip holding every file of a game in the table, by CRC and size
    if(ext STREQUAL ".zip" AND size GREATER_EQUAL 22)
        zip_entries("${file}" ${size} entries)
        foreach(g IN LISTS cps1_games)
            set(all 1)
            foreach(f IN LISTS cps1_files_${g})
                if(NOT f IN_LIST entries)
                    set(all 0)
                    break()
                endif()
            endforeach()
            if(all)
                set(cps1 100)
            endif()
        endforeach()
    endif()
    # NES: iNES / NES 2.0 or FDS header; a raw FDS disk side: block 1, "*NINTENDO-HVC*"
    if(size GREATER_EQUAL 16)
        string(SUBSTRING "${head}" 0 8 magic)
        string(SUBSTRING "${head}" 0 30 disk)
        if(magic STREQUAL "4e45531a" OR magic STREQUAL "4644531a" OR disk STREQUAL "012a4e494e54454e444f2d4856432a")
            set(nes 100)
        endif()
    endif()
    # Game Boy: the logo at $104, the header checksum at $14D
    if(size GREATER_EQUAL 336)
        string(SUBSTRING "${head}" 520 96 logo)
        if(logo STREQUAL "ceed6666cc0d000b03730083000c000d0008111f8889000edccc6ee6ddddd999bbbb67636e0eecccdddc999fbbb9333e")
            set(x 0)
            foreach(i RANGE 308 332)  # $134-$14C
                math(EXPR at "${i} * 2")
                string(SUBSTRING "${head}" ${at} 2 b)
                math(EXPR x "(${x} - 0x${b} - 1) & 255")
            endforeach()
            string(SUBSTRING "${head}" 666 2 sum)  # $14D
            math(EXPR sum "0x${sum}")
            if(x EQUAL sum)
                set(gb 100)
            else()
                set(gb 70)
            endif()
        endif()
    endif()
    # Genesis: "SEGA" or " SEGA" at $100
    if(size GREATER_EQUAL 512)
        string(SUBSTRING "${head}" 512 8 sega)
        string(SUBSTRING "${head}" 512 10 sega5)
        if(sega STREQUAL "53454741" OR sega5 STREQUAL "2053454741")
            set(md 100)
        endif()
    endif()
    # Master System: "TMR SEGA" at $1FF0, $3FF0 or $7FF0, region 3 or 4 in its
    # last byte's high nibble (5-7: Game Gear); without one, a size in 8 KB
    # steps up to 1 MB is weak (the .sms extension decides)
    set(sms_header OFF)
    foreach(at 8176 16368 32752)
        math(EXPR min "${at} + 16")
        if(NOT sms_header AND size GREATER_EQUAL min)
            file(READ "${file}" sig OFFSET ${at} LIMIT 16 HEX)
            if(sig MATCHES "^544d522053454741")
                set(sms_header ON)
                string(SUBSTRING "${sig}" 30 1 region)
                if(region MATCHES "^[34]$")
                    set(sms 100)
                elseif(region MATCHES "^[567]$")
                    set(gg 100)
                elseif(NOT region MATCHES "^[567]$")
                    set(sms 70)
                endif()
            endif()
        endif()
    endforeach()
    if(NOT sms_header AND size GREATER 0 AND size LESS_EQUAL 1048576)
        math(EXPR rest "${size} % 8192")
        if(rest EQUAL 0)
            set(sms 20)
            set(gg 20)  # the same for the Game Gear: .gg decides
        endif()
    endif()
    # Atari 2600: a cartridge size and a reset vector into $1000-$1FFF
    if(size EQUAL 2048 OR size EQUAL 4096 OR size EQUAL 8192 OR size EQUAL 16384 OR size EQUAL 32768)
        math(EXPR at "${size} - 3")
        file(READ "${file}" vec OFFSET ${at} LIMIT 1 HEX)
        math(EXPR hi "0x${vec} & 16")
        if(hi)
            set(a26 20)  # alone below 30: the .a26 extension or --system decides
        else()
            set(a26 10)
        endif()
    endif()
    # the extension breaks ties (DETECT_EXT_BONUS)
    set(exts_nes ".nes;.fds")
    set(exts_gb ".gb;.gbc")
    set(exts_md ".md;.gen;.bin")
    set(exts_a26 ".a26")
    set(exts_sms ".sms")
    set(exts_gg ".gg")
    set(exts_cps1 ".zip")
    set(best "")
    set(best_score 0)
    set(tie "")
    foreach(id nes gb md a26 sms gg cps1)
        set(s ${${id}})
        if(s GREATER 0 AND ext IN_LIST exts_${id})
            math(EXPR s "${s} + 20")
        endif()
        if(s GREATER best_score)
            set(best ${id})
            set(best_score ${s})
            set(tie "")
        elseif(s EQUAL best_score AND s GREATER 0)
            set(tie ${id})
        endif()
    endforeach()
    if(best_score LESS 30)
        message(FATAL_ERROR "${file}: not a game of a known system")
    endif()
    if(tie AND best_score GREATER_EQUAL 90)
        message(FATAL_ERROR "${file}: could be ${best} or ${tie}")
    endif()
    set(system_nes nes)
    set(system_gb gb)
    set(system_md genesis)
    set(system_a26 atari2600)
    set(system_sms mastersystem)
    set(system_gg gamegear)
    set(system_cps1 cps1)
    set(${out} ${system_${best}} PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED FILE)
    detect_system("${FILE}" sys)
    message("${sys}")
endif()
